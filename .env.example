# ============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha as chaves.
# `.env` está no .gitignore — nunca comite credenciais.
#
# A aplicação lê TODAS as credenciais daqui (src/config.py). Nenhuma chave
# aparece em HTML, JavaScript, dados RAW ou nas DAGs geradas.
# ============================================================================

# ── YouTube Data API v3 (obrigatória) ────────────────────────────────────────
# console.cloud.google.com → APIs e serviços → Credenciais → Chave de API
YOUTUBE_API_KEY=

# ── Provider de LLM usado por padrão pelo agente ─────────────────────────────
# groq | openai | anthropic | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# ── Chaves dos providers — preencha só o que você usa ────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Proxies para a coleta de transcrições (opcional) ─────────────────────────
# O YouTube às vezes bloqueia requisições de transcrição vindas de IP de
# datacenter (erro RequestBlocked/IpBlocked). Duas estratégias — escolha uma:
#
# 1) Webshare nativo (recomendado, mas requer o pacote "Residential" da
#    Webshare — "Proxy Server"/"Static Residential"/gratuito NÃO funcionam
#    de forma confiável, o YouTube bloqueia esses também). Prioridade sobre
#    a opção 2 se ambas estiverem preenchidas. Credenciais em
#    dashboard.webshare.io/proxy/settings ("Proxy Username"/"Proxy Password").
# YOUTUBE_WEBSHARE_USERNAME=
# YOUTUBE_WEBSHARE_PASSWORD=
#
# 2) Lista estática de proxies HTTP — CSV no formato
#    `host:porta:usuario:senha`, uma linha por proxy (exportação padrão da
#    Webshare para os pacotes "Proxy Server"/"Static Residential"). Guarde o
#    arquivo em config/ (já no .gitignore) para nunca ser commitado.
# YOUTUBE_PROXY_LIST=config/meus_proxies.csv
#
# Sem nenhuma das duas, a coleta funciona normalmente sem proxy.

# ── Endpoints alternativos (opcional) ────────────────────────────────────────
# Sobrescreve a base URL de um provider — útil para gateways/proxies.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=

# ── Airflow ──────────────────────────────────────────────────────────────────
# Raiz do projeto no worker do Airflow, para que `import src...` funcione.
# Se não definida, a DAG usa o caminho absoluto gravado na geração.
# FORD_FIAP_HOME=/opt/ford_fiap
