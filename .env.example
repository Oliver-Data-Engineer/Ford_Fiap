# ============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha as chaves.
# `.env` está no .gitignore — nunca comite credenciais.
#
# A aplicação lê TODAS as credenciais daqui (src/config.py). Nenhuma chave
# aparece em HTML, JavaScript, dados RAW ou nas DAGs geradas.
# ============================================================================

# ── YouTube Data API v3 (obrigatória) ────────────────────────────────────────
# console.cloud.google.com → APIs e serviços → Credenciais → Chave de API
YOUTUBE_API_KEY=

# ── Provider de LLM usado por padrão pelo agente ─────────────────────────────
# groq | openai | anthropic | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# ── Chaves dos providers — preencha só o que você usa ────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Proxies para YouTube Data API v3 + coleta de transcrições (opcional) ─────
# O YouTube às vezes bloqueia requisições vindas de IP de datacenter (erro
# RequestBlocked/IpBlocked na transcrição). Três estratégias — prioridade
# nessa ordem quando mais de uma está preenchida:
#
# 1) Webshare nativo — só afeta a transcrição (usa WebshareProxyConfig da
#    própria biblioteca). Requer o pacote "Residential" da Webshare —
#    "Proxy Server"/"Static Residential"/gratuito NÃO funcionam de forma
#    confiável, o YouTube bloqueia esses também. Credenciais em
#    dashboard.webshare.io/proxy/settings ("Proxy Username"/"Proxy Password").
# YOUTUBE_WEBSHARE_USERNAME=
# YOUTUBE_WEBSHARE_PASSWORD=
#
# 2) Lista de proxies por URL de download — afeta TANTO a YouTube Data API
#    quanto a transcrição. Aponte para o link de "Download" do painel da
#    Webshare (Proxy List → Download): sempre baixa o plano atual, não fica
#    desatualizado como um arquivo salvo. A URL carrega um token de acesso —
#    trate como credencial (nunca commitar, nunca logar).
# YOUTUBE_PROXY_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/download/SEU_TOKEN/-/any/username/direct/-/?plan_id=SEU_PLANO
#
# 3) Lista estática local — mesmo formato de linha (`host:porta:usuario:senha`),
#    mas salva em disco. Usada como fallback se a opção 2 estiver configurada
#    e a rede/URL falhar; ou sozinha, se preferir não depender de um fetch a
#    cada execução. Guarde o arquivo em config/ (já no .gitignore).
# YOUTUBE_PROXY_LIST=config/meus_proxies.csv
#
# Sem nenhuma das três, a coleta funciona normalmente sem proxy.

# ── Endpoints alternativos (opcional) ────────────────────────────────────────
# Sobrescreve a base URL de um provider — útil para gateways/proxies.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=

# ── BigQuery — warehouse analítico do Dashboard do YouTube (opcional) ───────
# Alimenta as tabelas cross-execução (canais buscados, transcrições e
# comentários coletados, comentários após o enriquecimento da LLM) que a aba
# Dashboard consulta. Aditivo — sem isso configurado, a coleta/pipeline do
# Playground funciona normalmente, só o warehouse fica desabilitado.
#
# Autenticação por ADC (Application Default Credentials), mesmo padrão do
# notebook tabela_marcas.ipynb: aponte para o JSON de uma service account
# com permissão de BigQuery Data Editor + Job User. Nunca commitar esse
# arquivo — trate como qualquer outra credencial.
# GOOGLE_APPLICATION_CREDENTIALS=config/gcp-service-account.json

# Projeto GCP explícito (opcional) — se ausente, é resolvido a partir da
# própria credencial (client.project), igual o notebook faz.
# GOOGLE_CLOUD_PROJECT=

# Dataset onde as tabelas analíticas do YouTube são criadas/gravadas.
# BIGQUERY_DATASET=youtube_analytics

# ── Gov Mode — catálogo FIPE (marca/modelo/ano) no BigQuery (opcional) ──────
# Usa o mesmo GOOGLE_APPLICATION_CREDENTIALS/GOOGLE_CLOUD_PROJECT acima, mas
# um dataset separado (analytics_ford — o mesmo do notebook tabela_marcas.ipynb).
# GOVMODE_BIGQUERY_DATASET=analytics_ford

# Token da FIPE (parallelum.com.br) — só é usado nas chamadas que resolvem o
# código FIPE de um modelo/ano (endpoint .../anos e .../anos/{ano}), enviado
# no header X-Subscription-Token, igual o notebook já faz. Sem isso, marcas e
# modelos ainda são coletados normalmente — só a etapa de código FIPE falha.
# FIPE_API_TOKEN=

# ── Scraper Mode — auto-discovery de sites de carro (opcional) ──────────────
# Dataset onde ficha técnica/anúncios/comentários coletados são gravados
# (mesmo GOOGLE_APPLICATION_CREDENTIALS/GOOGLE_CLOUD_PROJECT do BigQuery
# acima, dataset separado do Gov Mode).
# SCRAPER_BIGQUERY_DATASET=scraper_ford

# Proxy — mesma lógica de prioridade do bloco YouTube acima (lista por URL de
# download tem prioridade sobre a lista estática local). Sem nenhuma das
# duas, a coleta roda normalmente sem proxy.
# SCRAPER_PROXY_LIST_URL=
# SCRAPER_PROXY_LIST=config/meus_proxies.csv

# Playwright (motor de renderização usado no auto-discovery e na extração de
# anúncios/comentários — sites de ficha técnica geralmente nem precisam de
# JS, mas o mesmo motor é usado pros três objetivos por simplicidade).
# Requer rodar `playwright install chromium` uma vez após o pip install.
# SCRAPER_PLAYWRIGHT_HEADLESS=true
# SCRAPER_PLAYWRIGHT_TIMEOUT_MS=20000
# SCRAPER_DISCOVERY_MAX_HTML_CHARS=40000

# ── Airflow ──────────────────────────────────────────────────────────────────
# Raiz do projeto no worker do Airflow, para que `import src...` funcione.
# Se não definida, a DAG usa o caminho absoluto gravado na geração.
# FORD_FIAP_HOME=/opt/ford_fiap
